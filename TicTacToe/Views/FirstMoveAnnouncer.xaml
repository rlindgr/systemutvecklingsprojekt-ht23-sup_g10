<Window x:Class="YourNamespace.FirstMoveAnnouncer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="Window_Loaded"
        Cursor="Hand"
        Background="#F5ECD4"
        Title="First Move Announcer" Height="300" Width="400">
    <Grid x:Name="RootGrid">
        <Label x:Name="MessageLabel" Foreground="#228B22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24"/>
    </Grid>
</Window>
