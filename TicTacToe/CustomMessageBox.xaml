<Window x:Class="YourNamespace.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Välj motståndare" Height="200" Width="400">
    <Grid>
        <!-- StackPanel används för att organisera olika kontroller vertikalt -->
        <StackPanel>
            <!-- TextBlock för att visa huvudfrågan om typ av motståndare -->
            <TextBlock Text="Vill du spela mot en vän eller mot AI?" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>

            <!-- Horisontell StackPanel för att placera knappar sida vid sida -->
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Bottom" 
                        HorizontalAlignment="Center">
                <!-- Knapp för att välja att spela mot en vän -->
                <Button Content="Vän" 
                        Click="FriendButton_Click" 
                        Margin="10"/>

                <!-- Knapp för att välja att spela mot AI -->
                <Button Content="AI" 
                        Click="AIButton_Click" 
                        Margin="10"/>
            </StackPanel>

            <!-- TextBlock för att förtydliga att användaren måste välja antal i rad för att vinna -->
            <TextBlock Text="Välj antal i rad för att vinna:"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- ComboBox för att låta användaren välja antal i rad -->
            <ComboBox Name="WinLengthComboBox" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Center">
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
