<Window x:Class="YourNamespace.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Välj motståndare" Height="400" Width="800"
        Cursor="Hand"
        Background="#F5ECD4">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Background="#D4BF9D">
            <TextBlock Text="Vill du spela mot en vän eller mot AI?"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#8B4513"/>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center">
                <Button Content="Vän"
                        Click="FriendButton_Click"
                        Margin="10"
                        Height="60" Width="120"
                        FontSize="18"
                        Background="#8B4513"
                        Foreground="White"/>
                <Button Content="AI"
                        Click="AIButton_Click"
                        Margin="10"
                        Height="60" Width="120"
                        FontSize="18"
                        Background="#228B22"
                        Foreground="White"/>
            </StackPanel>

            <TextBlock Text="Välj antal i rad för att vinna:"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#8B4513"/>

            <ComboBox Name="WinLengthComboBox"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Height="40" Width="100"
                      FontSize="24"
                      Cursor="Hand">
                <ComboBoxItem Cursor="Hand" Content="3"/>
                <ComboBoxItem Cursor="Hand" Content="4"/>
                <ComboBoxItem Cursor="Hand" Content="5"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Välj svårighetsgrad:"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           Foreground="#8B4513"/>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <RadioButton Content="Lätt" Name="EasyRadio" FontSize="18" Margin="10" IsChecked="True"/>
                    <RadioButton Content="Mellan" Name="MediumRadio" FontSize="18" Margin="10"/>
                    <RadioButton Content="Svår" Name="HardRadio" FontSize="18" Margin="10"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
