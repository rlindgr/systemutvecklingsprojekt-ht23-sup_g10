<Window
    x:Class="YourNamespace.MainMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YourNamespace"
    xmlns:vm="clr-namespace:TicTacToe.ViewModels"
    Title="Välj motståndare" Height="400" Width="800"
    Cursor="Hand"
    Background="#F5ECD4">

    <Window.DataContext>
        <vm:MainMenuViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Background="#D4BF9D">
            <TextBlock Text="Välj antal i rad för att vinna:" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#8B4513"/>
            <ComboBox Name="WinLengthComboBox" 
                      ItemsSource="{Binding WinLengthOptions}" 
                      SelectedItem="{Binding SelectedWinLength}"                     
                      VerticalAlignment="Center" HorizontalAlignment="Center" Height="40" Width="100" FontSize="24" Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding GameSettings.AlgorithmType}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Margin="0,0,10,0" Foreground="#8B4513"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <RadioButton Content="Lätt" FontSize="18" Margin="10" IsChecked="{Binding IsEasySelected}"/>
                    <RadioButton Content="Mellan" FontSize="18" Margin="10" IsChecked="{Binding IsMediumSelected}"/>
                    <RadioButton Content="Svår" FontSize="18" Margin="10" IsChecked="{Binding IsHardSelected}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Vill du spela mot en vän eller mot AI?" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#8B4513"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                <Button Content="Vän"
                        Command="{Binding FriendCommand}"
                        Height="60" Width="120"
                        FontSize="18"
                        Background="#8B4513"
                        Foreground="White"/>
                <Button Content="AI"
                        Command="{Binding AICommand}"
                        Height="60" Width="120"
                        FontSize="18"
                        Background="#228B22"
                        Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
