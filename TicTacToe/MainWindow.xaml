<Window x:Class="FiveInARow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FiveInARow"
        Title="5 i rad" Height="800" Width="800"
        Cursor="Hand">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Lägger till en volymslider och ikon i det övre högra hörnet -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Image Source="C:\Users\eriks\source\repos\TicTacToe\TicTacToe\103711_louder_speaker_icon.png" Width="24" Height="24"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding Volume}"
                    Width="100" Height="20"/>
        </StackPanel>

        <!-- Ditt ursprungliga ItemsControl här -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="5" Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Value}" 
                            Command="{Binding Path=DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                            CommandParameter="{Binding}"
                            FontSize="60">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <!-- Default Background -->
                                <Setter Property="Background" Value="#704214" />
                                <!-- Mörkbrunt -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="X">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Value}" Value="O">
                                        <Setter Property="Foreground" Value="Blue"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                        <Setter Property="Background" Value="#D4BF9D"/>
                                        <!-- Ljusare färg -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
