<Window x:Class="FiveInARow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FiveInARow"
        Title="5 i rad" Height="800" Width="800"
        Cursor="Hand">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ny StackPanel för att visa antal vinster -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Spelare X har vunnit: " />
            <TextBlock Text="{Binding PlayerXWins}" />
            <TextBlock Text=" gånger. Spelare O har vunnit: " />
            <TextBlock Text="{Binding PlayerOWins}" />
            <TextBlock Text=" gånger." />
        </StackPanel>

        <!-- Din ursprungliga StackPanel för volym -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Image Source="C:\Users\eriks\source\repos\TicTacToe\TicTacToe\103711_louder_speaker_icon.png" Width="24" Height="24"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Width="100" Height="20"/>
        </StackPanel>

        <!-- Lägger till en StackPanel för att indikera vems tur det är och andra kontroller -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="Nuvarande Spelare: " Margin="5"/>
            <TextBlock Text="{Binding CurrentPlayer}" Margin="5"/>
            <Button Content="Öppna inställningar" Command="{Binding OpenSettingsCommand}" Margin="15,0,0,0"/>
            <Button Content="Återställ vinsttal" Command="{Binding ResetWinsCommand}" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Ditt ursprungliga ItemsControl här -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="5" Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Value}" 
                            Command="{Binding Path=DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                            CommandParameter="{Binding}"
                            FontSize="60">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <!-- Default Background -->
                                <Setter Property="Background" Value="#704214" />
                                <!-- Mörkbrunt -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="X">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Value}" Value="O">
                                        <Setter Property="Foreground" Value="Blue"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                        <Setter Property="Background" Value="#D4BF9D"/>
                                        <!-- Ljusare färg -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
